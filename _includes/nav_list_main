{%- comment -%}
  사이드바 카테고리 트리.
  groups 형식: "그룹명|그룹링크|카테고리키:슬러그[:표시명],…" 을 ";" 로 이어 쓴다.
  카테고리키는 site.categories 의 키(대소문자 그대로), 슬러그는 /categories/<슬러그> 페이지.
  개수는 site.categories 를 순회해 센다 — site.categories[변수] 조회는 Jekyll에서 nil 이 된다.
{%- endcomment -%}
{%- assign groups = "Mobile|/categories/mobile|Android:android,Flutter:flutter,iOS:ios;Front End|/categories/fe|React:react,HTML:html;Programming Language|/categories/pl|Kotlin:kotlin,Coroutine:coroutine;Topics||OOP:oop,refactoring:refactoring:리팩토링,Book:book,ML:ml:Machine Learning,Daily:daily:Daily Life" | split: ";" -%}

<nav class="nav__list">
  <input id="ac-toc" name="accordion-toc" type="checkbox" />
  <label for="ac-toc">{{ site.data.ui-text[site.locale].menu_label | default: "Toggle Menu" }}</label>
  <ul class="nav__items">
    <li class="nav__summary">
      <a href="{{ '/categories/' | relative_url }}"{% if page.url == '/categories/' %} class="active"{% endif %}>전체 글<span class="nav__count">{{ site.posts | size }}</span></a>
    </li>
    {%- for group in groups -%}
      {%- assign parts = group | split: "|" -%}
      {%- assign items = parts[2] | split: "," -%}
      {%- assign total = 0 -%}
      {%- for item in items -%}
        {%- assign fields = item | split: ":" -%}
        {%- for category in site.categories -%}
          {%- if category[0] == fields[0] -%}{%- assign total = total | plus: category[1].size -%}{%- endif -%}
        {%- endfor -%}
      {%- endfor -%}
    <li class="nav__group">
      {%- if parts[1] != "" -%}
      <a href="{{ parts[1] | relative_url }}" class="nav__sub-title{% if page.url == parts[1] %} active{% endif %}">{{ parts[0] }}<span class="nav__count">{{ total }}</span></a>
      {%- else -%}
      <span class="nav__sub-title">{{ parts[0] }}<span class="nav__count">{{ total }}</span></span>
      {%- endif -%}
      <ul>
        {%- for item in items -%}
          {%- assign fields = item | split: ":" -%}
          {%- assign label = fields[2] | default: fields[0] -%}
          {%- assign url = "/categories/" | append: fields[1] -%}
          {%- assign count = 0 -%}
          {%- for category in site.categories -%}
            {%- if category[0] == fields[0] -%}{%- assign count = category[1].size -%}{%- endif -%}
          {%- endfor -%}
        <li><a href="{{ url | relative_url }}"{% if page.url == url %} class="active"{% endif %}>{{ label }}<span class="nav__count">{{ count }}</span></a></li>
        {%- endfor -%}
      </ul>
    </li>
    {%- endfor -%}
  </ul>
</nav>
